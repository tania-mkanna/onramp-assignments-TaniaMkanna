datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model RawPage {
  id             String           @id @default(uuid())
  url            String           @unique
  domain         String
  fetchedAt      DateTime         @default(now())
  versions       RawPageVersion[]
  processedPages ProcessedPage[]

  @@index([domain])
  @@map("raw_pages")
}

model RawPageVersion {
  id          String   @id @default(uuid())
  rawPageId   String
  version     Int
  htmlContent String   @db.Text
  contentHash String
  statusCode  Int
  fetchedAt   DateTime @default(now())

  processedPage ProcessedPage?

  rawPage RawPage @relation(fields: [rawPageId], references: [id])

  @@unique([rawPageId, version])
  @@index([contentHash])
  @@map("raw_page_versions")
}

model ProcessedPage {
  id               String   @id @default(uuid())
  rawPageId        String
  rawPageVersionId String   @unique
  title            String
  cleanedText      String   @db.Text
  structuredData   Json // Stores extracted tables, headers, metadata JSON
  processedAt      DateTime @default(now())

  rawPage        RawPage        @relation(fields: [rawPageId], references: [id], onDelete: Cascade)
  rawPageVersion RawPageVersion @relation(fields: [rawPageVersionId], references: [id])

  @@index([rawPageId])
  @@map("processed_pages")
}
